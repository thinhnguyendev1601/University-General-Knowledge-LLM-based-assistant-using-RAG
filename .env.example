# LOCAL DEVELOPMENT ONLY. Copy to .env; do not reuse these credentials in production.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://university:local-development-only@127.0.0.1:55432/university
POSTGRES_USER=university
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=university
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
SESSION_SECONDS=28800
SESSION_IDLE_SECONDS=1800
SESSION_CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:56379/0
SESSION_CACHE_TTL_SECONDS=60
REDIS_TIMEOUT_SECONDS=0.2
RESET_SECONDS=900

# Mailpit receives local test messages; it does not deliver to real university inboxes.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=no-reply@university.edu.vn

# Set false to work on accounts without downloading/loading RAG models.
RAG_ENABLED=true
RAG_LLM=ollama
RAG_LLM_MODEL=llama3.2
CHAT_GENERATION_LEASE_SECONDS=900
# Single API process: one RAG task runs, at most two wait. HTTP chat stays synchronous.
CHAT_MAX_WAITING=2
CHAT_QUEUE_TIMEOUT_SECONDS=10
CHAT_PROCESSING_TIMEOUT_SECONDS=180
